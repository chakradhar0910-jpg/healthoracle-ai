# HealthOracle AI — Environment Variables Template
# Copy this file to .env and fill in your real values
# NEVER commit the .env file to git

# API Server
HEALTHORACLE_API_HOST=127.0.0.1
HEALTHORACLE_API_PORT=8000
HEALTHORACLE_DEBUG=false

# CORS
HEALTHORACLE_CORS_ORIGINS=*

# Logging
HEALTHORACLE_LOG_LEVEL=INFO

# Gemini API Key (for LLM/OCR features)
HEALTHORACLE_GEMINI_API_KEY=your-gemini-api-key-here
